# ============================================================
# Sniper Buying Agent Operations OS — 환경변수
#
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 들어간다.
# 나머지는 절대 클라이언트에서 참조하지 말 것.
# 설정 상태는 GET /api/health로 확인할 수 있다(값은 노출되지 않는다).
# ============================================================

# ─── Supabase (필수) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# 서버 전용. 세션·감사 로그·에이전트 실행이 이 키로 동작한다.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── 관리자 인증 (필수) ──────────────────────────────────────
ADMIN_PASSWORD=your_secure_admin_password
# 세션 토큰 서명 키. 최소 16자 이상이어야 하며, 값을 바꾸면
# 발급된 모든 세션이 즉시 무효가 된다(= 전체 강제 로그아웃).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=generate_with_the_command_above

# ─── 상품 발굴 파이프라인 ────────────────────────────────────
# 없으면 /api/discover/* 가 동작하지 않는다.
FIRECRAWL_API_KEY=your_firecrawl_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# 선택. 미설정 시 코드 기본값을 사용한다.
OPENROUTER_MODEL=

# ─── 레거시 스토어 (고객용 화면) ─────────────────────────────
# 'false'로 두면 공개 스토어와 관련 API가 인증 뒤로 잠긴다.
# 지시서는 최종적으로 false를 요구하지만, 진행 중인 실주문·고객
# 확인 전까지는 켜 둔다. 미설정 시 기본값은 켜짐(true)이다.
ENABLE_LEGACY_STORE=true

# ─── Toss Payments ───────────────────────────────────────────
# 주의: 현재 서버 승인(POST /v1/payments/confirm) 단계가 구현되어 있지
# 않다. 결제창은 뜨지만 실제 수납은 완료되지 않으며, 생성된 주문은
# payment_status='unconfirmed'로 기록된다. TOSS_SECRET_KEY는 승인
# 라우트를 구현할 때 사용한다 — 현재 코드에서는 참조하지 않는다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=your_toss_client_key
TOSS_SECRET_KEY=your_toss_secret_key

# ─── 사이트 ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ─── Make.com 자동화 ─────────────────────────────────────────
# 앱이 Make로 내보낼 때 쓰는 수신 URL (선택)
MAKE_WEBHOOK_URL=your_make_webhook_url
# Make가 앱을 호출할 때 쓰는 공유 시크릿.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTOMATION_WEBHOOK_SECRET=generate_with_the_command_above

# ─── 알림 (선택) ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
