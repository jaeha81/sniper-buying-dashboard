# ── Supabase (서비스롤 — 서버에서만 사용) ────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── 로컬 Model Gateway (보안터널 너머) ────────────────────────────────────
# 미설정 시 데몬은 heuristic-only 모드(LLM 보강 판단 스킵, 방어 로직은 유지)
MODEL_GATEWAY_URL=https://gateway.YOUR-TAILNET.ts.net
MODEL_GATEWAY_TOKEN=YOUR_GATEWAY_TOKEN
MODEL_GATEWAY_TIMEOUT_MS=60000

# ── 자율 운영 ─────────────────────────────────────────────────────────────
# 단계: 0=관찰 1=방어 2=운영 3=수익(예산구매). 초기엔 0 권장.
AUTONOMY_STAGE=0
# 스케줄러 최소 틱 간격(초)
TICK_INTERVAL_SEC=60
# 드라이런: 실제 DB 변경 없이 결정만 로그 (초기 관찰용, 기본 true)
AGENT_OS_DRY_RUN=true

# ── 알림 (선택) ───────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
