# systemd 유닛 — 오라클 클라우드 VM 상주화
# 설치:
#   sudo cp agent-os/deploy/sniper-agent-os.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sniper-agent-os
#   journalctl -u sniper-agent-os -f      # 로그 확인
[Unit]
Description=Sniper Agent OS (autonomous buying daemon)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 배포 경로에 맞게 수정
WorkingDirectory=/opt/sniper/agent-os
EnvironmentFile=/opt/sniper/agent-os/.env
# Node 20+ / npm i 후 tsx 로 실행
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
# 안전: 서비스롤 키가 담긴 .env 는 600 권한, 이 사용자만 접근
User=sniper
Group=sniper
# 리소스 가드(Always Free A1 기준 여유롭게)
MemoryMax=1G

[Install]
WantedBy=multi-user.target
